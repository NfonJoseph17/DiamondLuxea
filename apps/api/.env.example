# Database
DATABASE_URL="postgresql://user:password@localhost:5432/bar_depot_db?schema=public"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-in-production"

# Server (Railway injects PORT in production; default 3000 for local)
PORT=3001

# CORS - Frontend URL for development
FRONTEND_URL="http://localhost:3000"
